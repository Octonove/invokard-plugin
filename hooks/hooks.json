{
  "description": "Invokard: injects the always-on rules (The Orchestrator and The Workflower) when the session starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js"],
            "timeout": 10,
            "statusMessage": "Loading Invokard rules"
          }
        ]
      }
    ]
  }
}
